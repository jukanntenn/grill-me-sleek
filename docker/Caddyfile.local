# e2e 和本地验收环境 Caddy 配置（自签名 TLS）
# 使用 Caddy tls internal 自动生成自签名证书，模拟生产环境的 HTTPS

{
    local_certs
}

localhost:8443 {
    # 自动生成自签名证书
    tls internal

    # Security headers
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'"
        X-Content-Type-Options "nosniff"
    }

    # Compression（排除 SSE 路径）
    @compressable {
        not path /v1/sessions/*/events
    }
    encode @compressable zstd gzip

    # Static files（由 Caddy 服务，不经过 Rust）
    root * /app/web/dist
    file_server

    # Cache-Control for Entry HTML
    @html path /
    header @html Cache-Control "public, max-age=300"

    # Cache-Control for assets
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Reverse proxy to Rust backend
    reverse_proxy /v1/* 127.0.0.1:8000 {
        transport http {
            versions h2c
        }
        health_uri      /v1/healthz
        health_interval 10s
        health_timeout  2s
        flush_interval  -1
    }

    # API responses: no-store
    @api path /v1/*
    header @api Cache-Control "no-store"
}
