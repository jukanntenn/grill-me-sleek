# {{ ansible_managed }}
# grilling-sleek Caddyfile (production — ttyo, behind Cloudflare).
#
# Plain HTTP only. TLS terminates on the host Caddy gateway (port 443,
# Cloudflare Origin CA cert, Full strict) — the shared systemd Caddy on the
# VPS — which reverse-proxies grillingsleek.online to the loopback-published
# port below; because that port binds 127.0.0.1, the host gateway is the only
# possible peer. The direct-8443 era's @not_cf CIDR gate and CF-CIDR
# trusted_proxies are gone with it: the host firewall (443 open to Cloudflare
# CIDRs only) is the enforcement point, and 443 is the one proxied HTTPS port
# where the edge actually caches.
#
# trusted_proxies private_ranges covers the gateway's NAT'd bridge address as
# seen from the container. The default XFF append is superseded by the
# header_up rewrite: CF-Connecting-IP passes through the gateway untouched
# (not a hop-by-hop header), so the XFF reaching Rust is always the single
# Cloudflare-asserted client IP — the contract server/src/main.rs's governor
# extractor and handlers::extract_client_ip rely on.

{
    auto_https off
}

:8443 {
    # Security headers
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Compression (exclude SSE path to preserve real-time flush)
    @compressable {
        not path /v1/sessions/*/events
    }
    encode @compressable zstd gzip

    # Static files (served by Caddy, not Rust)
    root * /app/web/dist
    file_server

    # Cache-Control for Entry HTML (5min; edge-caches on 443 via the
    # cache-entry-html Cache Rule — without it HTML is always DYNAMIC)
    @html path /
    header @html Cache-Control "public, max-age=300"

    # Cache-Control for assets (immutable, 1 year; cached by default on 443
    # — static file extensions are edge-cacheable without any rule)
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Reverse proxy to Rust backend
    reverse_proxy /v1/* 127.0.0.1:8000 {
        trusted_proxies private_ranges
        transport http {
            versions h2c
        }
        health_uri      /v1/healthz
        health_interval 10s
        health_timeout  2s
        flush_interval  -1
        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
    }

    # API responses: no-store
    @api path /v1/*
    header @api Cache-Control "no-store"
}
