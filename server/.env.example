# SQLx build-time configuration for local development.
#
# Copy to `server/.env` (gitignored). sqlx-cli and the sqlx macros read this
# automatically when run from `server/`.
#
# - `SQLX_OFFLINE=true` makes `cargo build` use the checked-in `.sqlx/` cache
#   instead of connecting to a database. This keeps local builds deterministic
#   and lets you compile without a running DB.
# - `DATABASE_URL` points at the dev DB. `cargo sqlx prepare` (run via
#   `python3 scripts/migrate.py prepare`) overrides `SQLX_OFFLINE=false` for the
#   duration of that command so it can connect and refresh the cache.

SQLX_OFFLINE=true
DATABASE_URL=sqlite://server/data/dev.db
